# Nexora AI — environment template (Phase 2.7)
#
# This file is a TEMPLATE ONLY. It contains no real secrets — every
# secret value below is intentionally empty.
#
# Setup:
#   cp .env.example .env.local
#   # then fill in the keys you actually have in .env.local
#
# `.env.local` is gitignored and must never be committed. This file
# (`.env.example`) is safe to commit because it holds no real values.

# --- AI Providers (server-only, optional) ---
# OPENAI_API_KEY — optional, server-only. Read by src/lib/server/env.ts.
#   Leave empty until you have a real OpenAI key.
OPENAI_API_KEY=
# GEMINI_API_KEY — optional, server-only. Read by src/lib/server/env.ts.
#   Leave empty until you have a real Google Gemini key.
GEMINI_API_KEY=
# ANTHROPIC_API_KEY — optional, server-only. Read by src/lib/server/env.ts.
#   Leave empty until you have a real Anthropic Claude key.
ANTHROPIC_API_KEY=

# --- App (public) ---
# NEXT_PUBLIC_APP_NAME — optional, public. Shown in the UI; defaults to "Nexora AI".
NEXT_PUBLIC_APP_NAME=Nexora AI
# NEXT_PUBLIC_APP_URL — optional, public. Base URL of the app; defaults to http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (single pair, browser AND server) ---
# NEXT_PUBLIC_SUPABASE_URL — optional, public. Your Supabase project URL.
# NEXT_PUBLIC_SUPABASE_ANON_KEY — optional, public (publishable key).
#   The value may be either the legacy anon JWT (eyJ…) or a new
#   publishable key (sb_publishable_…); both are accepted in the same
#   slot by the installed SDKs. Safe to expose by design.
#   This ONE pair is the single source of truth: the browser client
#   (src/lib/supabase/client.ts) AND the server client + proxy
#   (src/lib/supabase/server.ts, src/lib/supabase/middleware.ts) all
#   read these two names. There is no separate server-only pair since
#   Phase 3.1.1 — the old names were removed and setting them does
#   nothing (see docs/environment.md).
#   Leave empty until a Supabase project exists.
NEXT_PUBLIC_SUPABASE_URL=https://rxibszpvzfpsaucuxowa.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_4oSHdsJmhRMHBofBCbNoXw_Zw-8zXOO
# SUPABASE_SERVICE_ROLE_KEY — optional, server-only, SECRET. Bypasses Row
#   Level Security. Never expose it to the browser, never put it in a
#   NEXT_PUBLIC_ variable, and never commit it. Leave empty for now.
SUPABASE_SERVICE_ROLE_KEY=
